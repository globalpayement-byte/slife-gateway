# Adikao ho .env ity rakitra ity, dia ovay ny mots de passe.
#   cp .env.example .env

# Anaran'ny base — TSY maintsy "slife_gateway" (mifanaraka amin'ny schema.sql)
DB_NAME=slife_gateway

# Mots de passe MariaDB (ovay ho mafy!)
DB_ROOT_PASSWORD=CHANGE_ME_root_pwd
DB_USER=slife
DB_PASSWORD=CHANGE_ME_user_pwd

# Port server (ivelany)
PORT=3000
